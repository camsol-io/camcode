{
  "name": "@camsol.io/camcode",
  "version": "0.1.0",
  "description": "Fast QR code and Data Matrix reader for the browser and Node, built on zxing-cpp (WebAssembly), with a camera scanner",
  "keywords": [
    "qr",
    "qrcode",
    "datamatrix",
    "barcode",
    "scanner",
    "camera",
    "zxing",
    "wasm"
  ],
  "license": "MIT",
  "author": "Camsol Services GmbH",
  "homepage": "https://github.com/camsol-io/camcode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camsol-io/camcode.git"
  },
  "bugs": {
    "url": "https://github.com/camsol-io/camcode/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@zxing/library": "0.20.0",
    "pngjs": "7.0.0",
    "typescript": "~5.6.3"
  }
}
